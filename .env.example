# ==============================================================================
# SS-Enterprise HR Agentic Solution — MVP 1 (.env.example)
# ==============================================================================

# 1. Google Cloud & Vertex AI Agent Engine Configuration
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=argolis-sandbox-main
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AGENT_ENGINE_REGION=us-central1
VERTEX_SEARCH_REGION=eu

# 2. Gemini Model Configuration (Primary + Deterministic Fallback)
HR_AGENT_MODEL=gemini-3.5-flash
HR_AGENT_FALLBACK_MODEL=gemini-2.5-flash
HR_EVAL_JUDGE_MODEL=gemini-3.5-flash

# 3. Upstream Mock SaaS Enterprise Specification (WorkWeek HCM & ServiceImmediately ITSM)
MOCK_SAAS_BASE_URL=https://mock-saas.aishprabhat.demo.altostrat.com
MOCK_SAAS_DOCS_URL=https://mock-saas.aishprabhat.demo.altostrat.com/docs
MOCK_SAAS_OPENAPI_URL=https://mock-saas.aishprabhat.demo.altostrat.com/openapi.json
MOCK_SAAS_IAP_CLIENT_ID=332638604308-825bkuk2cjp8h06t1g41o2lvk8oq9cnk.apps.googleusercontent.com
# Transport mode: "memory" (deterministic local/CI harness) | "live" (live IAP OIDC HTTP calls)
UPSTREAM_TRANSPORT_MODE=memory
UPSTREAM_TIMEOUT_SEC=10.0

# 4. Cloud Run MCP Proxy Service Endpoints
WORKWEEK_MCP_URL=http://localhost:8081/mcp
SERVICEDESK_MCP_URL=http://localhost:8082/mcp

# 5. Security, Privacy & OpenTelemetry Redaction Controls (NFR-015, NFR-016)
ALLOWED_COUNTRIES=NL,DE,CN
BLOCKED_COUNTRIES=TW
UCT_SIGNING_SECRET=local-dev-es256-hmac-secret-override-in-secret-manager
CT_SIGNING_SECRET=local-dev-ct-signing-secret-override-in-secret-manager
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
